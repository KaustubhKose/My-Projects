# =================================================================
# LifeLink Platform Environment Variables Configuration (.env.example)
# =================================================================

# 1. FRONTEND CONFIGURATION
VITE_APP_NAME="LifeLink Intelligent Healthcare OS"
VITE_API_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000/ws"
VITE_DEMO_MODE=true

# 2. FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS)
VITE_FIREBASE_API_KEY="AIzaSyDemoKeyExampleForFirebaseFCM"
VITE_FIREBASE_AUTH_DOMAIN="lifelink-emergency.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="lifelink-emergency"
VITE_FIREBASE_STORAGE_BUCKET="lifelink-emergency.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# 3. TWILIO SMS GATEWAY (EMERGENCY ALERTS)
VITE_TWILIO_ACCOUNT_SID="ACdemo1234567890abcdef1234567890"
VITE_TWILIO_AUTH_TOKEN="demoAuthToken1234567890abcdef"
VITE_TWILIO_PHONE_NUMBER="+15551234567"

# 4. BACKEND DATABASE (POSTGRESQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifelink_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="lifelink_secure_password"
POSTGRES_DB="lifelink_db"
POSTGRES_PORT=5432

# 5. JWT AUTHENTICATION & SECURITY
JWT_SECRET_KEY="lifelink-super-secret-jwt-key-2026-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 6. REDIS WEBSOCKET REALTIME MESSAGE BROKER
REDIS_URL="redis://localhost:6379/0"
